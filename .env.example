# 실제 값으로 채운 뒤 .env 로 복사해서 사용하세요.
# .env 파일 자체는 .gitignore 에 포함되어 있어 git에는 올라가지 않습니다.

POSTGRES_USER=chris
POSTGRES_PASSWORD=password
POSTGRES_DB=ecommerce
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# FastAPI 대시보드가 붙는 DB 커넥션 (기본은 위 postgres와 동일한 DB를 바라봄)
API_DB_URL=postgresql+psycopg2://chris:password@postgres:5432/ecommerce

# 로그 레벨: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
AIRFLOW_UID=50000
